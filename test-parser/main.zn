	y String("world");
	content String = read("wordlist.txt") ?? "";
	x Int(3);
	
	if random() {
		results List = crawl(content) ? error {
			std$print(error);
			abort error;
		};
	}
	else {
		rifle Weapon("rifle", 20);
		value Bool = ~true + 3;
	}

	loop i to 3 {
		std$print(i);
	}
	return Unit();
}

square Int (x Int, y Int) => x * y;

