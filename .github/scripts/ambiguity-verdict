#!/usr/bin/env bash
# Turn a proof report into a job result.
#
# `ambiguity prove` distinguishes its outcomes in the report text, not in its
# exit status: the engine returns 0 for "proven", for both flavours of "not
# proven", and for a concretized ambiguity alike, reserving a non-zero status
# for configuration and I/O errors. A workflow therefore cannot branch on the
# exit code, so the verdict is read from the report here.
#
# Unrecognized output is an error rather than a pass: a report whose verdict
# line has been reworded must stop the job loudly instead of being reported as
# a successful proof.
set -euo pipefail

: "${REPORT:?must be set}"

if [[ ! -f "$REPORT" ]]; then
	echo "ambiguity-verdict: no report at $REPORT" >&2
	exit 2
fi

# Both the terminal log and the job summary get the verdict; the summary is the
# part a scheduled run's reader sees without opening the log.
announce() {
	printf '%s\n' "$1"
	if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
		printf '%s\n\n' "$1" >>"$GITHUB_STEP_SUMMARY"
	fi
}

# Order matters. A concretized witness is printed after the abstract candidate
# that produced it, and it is the only outcome that means the grammar is broken.
if line=$(grep -m1 '^Found [0-9][0-9]* complete ambiguity' "$REPORT"); then
	announce "### Ambiguous grammar"
	announce "The proof attempt found a concrete ambiguous sentence: ${line}"
	announce "This is a bug in the grammar, not a limit of the abstraction. The witnesses and their conflict origins are in the report."
	exit 1
fi

if line=$(grep -m1 '^PROVEN UNAMBIGUOUS:' "$REPORT"); then
	announce "### Proven unambiguous"
	announce "${line}"
	announce "The proof carries no sentence-length bound: it holds for inputs of every length, up to renaming terminals within their equivalence class."
	exit 0
fi

# Two different reports share this prefix: the abstract pair limit was reached,
# or an abstract candidate could not be concretized. Both leave the grammar
# neither proven nor refuted, and both are expected outcomes rather than
# regressions, so they only fail the job when the caller asked them to.
if line=$(grep -m1 '^NOT PROVEN:' "$REPORT"); then
	announce "### Not proven"
	announce "${line}"
	announce "Neither proven unambiguous nor shown ambiguous. Raising the proof level may remove a spurious candidate; raising the memory budget may clear a pair-limit overflow."
	if [[ "${STRICT:-false}" == "true" ]]; then
		exit 1
	fi
	exit 0
fi

echo "ambiguity-verdict: no recognized verdict line in $REPORT" >&2
exit 2
