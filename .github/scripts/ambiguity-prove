#!/usr/bin/env bash
# Run one unambiguity proof attempt from the parameters in the environment.
#
# `devbox run` shell-quotes each argument it is given and then `eval`s the
# reassembled command line, so every argument is re-parsed by a shell before
# the command sees it. Workflow inputs therefore must not be passed as
# arguments: this script reads them from the environment, and the workflow
# invokes it with no arguments at all.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

: "${LEVEL:?must be set}"
: "${PROFILE:?must be set}"
: "${SEARCH_TIMEOUT:?must be set}"
: "${WITNESSES:?must be set}"
: "${REPORT:?must be set}"

# The proof level is the top-K stack abstraction depth, not a search bound: the
# abstract pair space grows exponentially in it, so the level is chosen per run
# rather than derived from the profile.
args=(
	prove "$LEVEL" "$PROFILE"
	--timeout "$SEARCH_TIMEOUT"
	--witnesses "$WITNESSES"
	--output "$REPORT"
)

# An empty token range means "keep the profile's own range". The range bounds
# only the concretization search that runs after an abstract candidate; the
# proof itself is unbounded in sentence length.
if [[ -n "${TOKENS:-}" ]]; then
	args+=(--tokens "$TOKENS")
fi

# A survey answers "how many blind spots" instead of "is it proven": it walks
# the whole abstract space rather than stopping at the first divergence, so it
# costs more and reports a count. Zero keeps the ordinary proof.
if [[ "${SURVEY:-0}" != "0" ]]; then
	args+=(--survey "$SURVEY")
fi

# Refinement deepens the retained stack only behind the candidate that needed
# it shallow, and tries again, so it reaches precision a uniform level of the
# same cost cannot. It is what tells a bounded blind spot from an unbounded
# one: a bounded one changes shape round by round and disappears, an unbounded
# one answers every round with a longer sentence. Zero keeps the single
# unrefined attempt.
if [[ "${REFINE:-0}" != "0" ]]; then
	args+=(--refine "$REFINE")
	if [[ -n "${REFINE_ROUNDS:-}" ]]; then
		args+=(--refine-rounds "$REFINE_ROUNDS")
	fi
fi

# An unbounded blind spot answers every round with a longer sentence, so a run
# that keeps refining it spends the whole clock on one site and reports nothing
# about the rest of the grammar. Retiring stops pursuing a site once it has
# stopped moving, names it, and carries on; the run then reports which sites are
# open instead of only which one it ran out of time on. It can never report a
# proof, so it costs no soundness.
#
# Passed outside the refinement branch on purpose. Retiring needs refinement to
# act on, and `ambiguity prove` is what says so -- dropping the option here when
# REFINE is unset would turn a workflow run that asked to retire into an hour of
# doing neither, reported as a success. Handing it over unconditionally lets
# that check fire and fail the step.
if [[ -n "${RETIRE:-}" && "${RETIRE}" != "0" ]]; then
	args+=(--retire "$RETIRE")
fi

# The report directory is created here as well as by --output, so the artifact
# upload finds a directory even when the run dies before its first write.
mkdir -p "$(dirname "$REPORT")"

# Proof mode reports its verdict in the exit status: 0 proven, 1 a concrete
# ambiguous sentence, 3 not proven, and 2 a run that went wrong. Reaching a
# verdict means this step did its job, whichever verdict it was, so the three
# verdict statuses pass and the job result is left to the verdict step. Any
# other status is a real failure and is re-raised.
status=0
"$ROOT/dev/bin/ambiguity" "${args[@]}" || status=$?

case "$status" in
	0 | 1 | 3) exit 0 ;;
	*) exit "$status" ;;
esac
